# Copy to .env and fill in locally. Never commit .env.

# --- Embeddings (CP2) -------------------------------------------------------
# gemini = approved provider (needs GEMINI_API_KEY)
# fake   = deterministic offline test double (no key, word-overlap only)
EMBEDDINGS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# --- Retrieval (CP2) --------------------------------------------------------
RAG_TOP_K=4
# Minimum cosine similarity for a chunk to count as evidence.
# Leave empty to use the provider default (fake 0.13, gemini 0.638 calibrated in CP2).
RAG_MIN_SCORE=

# --- Agent (CP3) -------------------------------------------------------------
# gemini = approved provider (needs GEMINI_API_KEY and GEMINI_MODEL)
# fake   = deterministic offline test double (bilingual keyword rules)
LLM_PROVIDER=gemini
# Required for the Gemini LLM. No default on purpose (decision C3-08): set the
# text model you confirmed against the real API.
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Session (CP3) -----------------------------------------------------------
SESSION_TTL_MINUTES=30
